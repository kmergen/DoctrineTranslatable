{
    "name": "kmergen/doctrine-translatable",
    "description": "Doctrine Translatable Bundle",
    "type": "symfony-bundle",
    "keywords": [
        "behaviors",
        "doctrine",
        "translatable"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Klaus Mergen"
        }
    ],
     "require": {
        "php": ">=8.4",
        "doctrine/orm": "^3.0",
        "doctrine/doctrine-bundle": "^3.0",
        "symfony/framework-bundle": "^8.0",
        "nette/utils": "^4.0"
    },
    "require-dev": {
        "rector/rector": "^1.2",
        "ext-pdo_mysql": "*",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kmergen\\DoctrineTranslatable\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kmergen\\DoctrineTranslatable\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    }
}