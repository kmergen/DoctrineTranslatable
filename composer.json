{
    "name": "kmergen/doctrine-translatable",
    "description": "Doctrine Translatable Bundle",
    "type": "symfony-bundle",
    "keywords": [
        "behaviors",
        "doctrine",
        "translatable"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Klaus Mergen"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/collections": "^2.2 || ^3.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^4.0",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/translation-contracts": "^3.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Kmergen\\DoctrineTranslatable\\": "src",
            "Kmergen\\DoctrineTranslatable\\PHPStan\\": "utils/phpstan-behaviors/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kmergen\\DoctrineTranslatable\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
